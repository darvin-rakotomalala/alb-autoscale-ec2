<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <springProperty scope="context" name="LOGS" source="modules.logging.logs.folder.path" defaultValue="./logs"/>
    <springProperty scope="context" name="appName" source="modules.logging.application.name" defaultValue="UNKNOWN"/>
    <property name="LOG_LEVEL_PATTERN" value="%-5level"/>

    <appender name="Console"
              class="ch.qos.logback.core.ConsoleAppender">
        <layout class="ch.qos.logback.classic.PatternLayout">
            <Pattern>
                %d{yyyy-MM-dd'T'HH:mm:ss.SSS} | ${appName} | %-20.20thread | ${LOG_LEVEL_PATTERN} | %-25.25logger{25} |
                %m%n
            </Pattern>
        </layout>
    </appender>

    <appender name="RollingFile"
              class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOGS}/${appName}.log</file>
        <encoder
                class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <Pattern>%d %p %c{1} [%t] %m%n</Pattern>
        </encoder>

        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOGS}/archived/${appName}-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
    </appender>

    <appender name="CLOUDWATCH" class="com.kdgregory.logback.aws.CloudWatchAppender">
        <logGroup>/aws/ec2/spring-boot-backend-app-tier</logGroup>
        <logStream>{ec2InstanceId}</logStream>
        <!-- Alternative if not on EC2 or if instance ID isn't available: -->
        <!-- <logStream>{hostname}-{pid}</logStream> -->
        <!-- Enables runtime evaluation of EC2 substitutions -->
        <useLocalInstanceMetadata>true</useLocalInstanceMetadata>
        <layout class="ch.qos.logback.classic.PatternLayout">
            <Pattern>
                %d{yyyy-MM-dd'T'HH:mm:ss.SSS} | ${appName} | %-20.20thread | ${LOG_LEVEL_PATTERN} | %-25.25logger{25} |
                %m%n
            </Pattern>
        </layout>
    </appender>

    <!-- LOG everything at INFO level -->
    <root level="INFO">
        <appender-ref ref="RollingFile"/>
        <appender-ref ref="Console"/>
        <appender-ref ref="CLOUDWATCH"/>
    </root>

    <!-- LOG "com.baeldung*" at TRACE level -->
    <logger name="com.ce" level="TRACE" additivity="false">
        <appender-ref ref="RollingFile"/>
        <appender-ref ref="Console"/>
        <appender-ref ref="CLOUDWATCH"/>
    </logger>

</configuration>
